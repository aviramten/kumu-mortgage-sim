{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(npm run lint*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git tag *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)"
    ]
  }
}
